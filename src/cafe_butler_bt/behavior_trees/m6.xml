<?xml version="1.0"?>

<root BTCPP_format="4">
  <BehaviorTree ID="Milestone6">
    <Sequence>
      <PublishFeedback state="MOVING_TO_KITCHEN"/>
      <NavigateToWaypoint waypoint="kitchen"/>
      <ForEachTable>
        <Sequence>
          <PublishFeedback state="MOVING_TO_TABLE"/>
          <NavigateToWaypoint waypoint="{current_table}"/>
          <PublishFeedback state="WAITING_TABLE_CONFIRM"/>
          <WaitForConfirmation location="{current_table}" timeout="15.0"/>
        </Sequence>
      </ForEachTable>
      <PublishFeedback state="RETURNING_VIA_KITCHEN"/>
      <NavigateToWaypoint waypoint="kitchen"/>
      <PublishFeedback state="RETURNING_HOME"/>
      <NavigateToWaypoint waypoint="home"/>
    </Sequence>
  </BehaviorTree>
</root>
