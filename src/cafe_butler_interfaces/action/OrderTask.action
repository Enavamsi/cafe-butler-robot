# Goal: a set of tables to serve in one "order" (1..N tables)
string[] tables            # e.g. ["table1"] or ["table1","table2","table3"]
string order_id            # free-form id for logging/feedback
---
# Result
bool success
string[] delivered_tables
string[] skipped_tables
string message
---
# Feedback
string state                # e.g. "MOVING_TO_KITCHEN","WAITING_KITCHEN_CONFIRM","MOVING_TO_TABLE1",...
string current_table
